# Copy this file to .env and fill in real values.

# OpenAI API key (used by the chat agent, the MCP tool and the embedding scripts)
YOUR_OPENAI_API_KEY=sk-...

# Postgres connection string for the Argo data (e.g. a Neon database).
# Format: postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require
POSTGRES_URI=postgresql+psycopg2://user:password@host/dbname?sslmode=require
